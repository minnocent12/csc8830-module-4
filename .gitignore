# Generated result and report artifacts. Keep directory placeholders tracked.
results/rgb/**
results/thermal/**
results/comparisons/**
results/metrics/**
docs/report/figures/**
!results/rgb/.gitkeep
!results/thermal/.gitkeep
!results/comparisons/.gitkeep
!results/metrics/.gitkeep
!docs/report/figures/.gitkeep

# Preserve intentionally selected small report evidence, following Module 3 conventions.
!results/metrics/*.csv
!results/metrics/*.md
!results/comparisons/*.md
!docs/report/figures/*.png

# Phase 8 keeps only the small, derived evidence images and serialized records.
!results/rgb/aau-vap-*.png
!results/thermal/aau-vap-*.png
!results/comparisons/aau-vap-*.png
!results/metrics/phase8_*.json
!results/metrics/phase8_*.csv
